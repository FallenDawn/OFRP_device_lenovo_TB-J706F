# /etc/recovery.fstab  (fs_mgr / libfs_mgr format, Android 12.1)
#
# Read by:
#   - fastbootd  : FastbootDevice ctor (unmount /cache), AutoMountMetadata (/metadata)
#   - bootloader_message : get_misc_blk_device() -> BCB clear on "Reboot to System"
#   - init       : SetInitAvbVersionInRecovery() / fs_mgr_vendor_overlay_mount_all()
#
# Format: <src> <mnt_point> <type> <mnt_flags> <fs_mgr_flags>
#
# IMPORTANT: deliberately only two entries.
#
#  * fastbootd obtains logical partitions from liblp/LP metadata, NOT from this
#    file, so /system,/system_ext,/vendor,/product entries are not needed.
#  * init in recovery also reads this file (SetInitAvbVersionInRecovery,
#    fs_mgr_vendor_overlay_mount_all).  Entries with "logical" would make
#    first-stage code treat dm-linear as enabled, and entries with
#    "first_stage_mount" would be mounted by init.  TWRP must stay in control
#    of super/dm-* mapping, so those entries and flags are intentionally absent.
#  * /metadata is needed by fastbootd's AutoMountMetadata (gsi / snapshot
#    commands); /misc is needed by bootloader_message (BCB clear).
#
# TWRP/OFRP reads /etc/twrp.fstab first and does not use this file for its own
# partition list, so data encryption flags live in twrp.fstab.

/dev/block/bootdevice/by-name/metadata                  /metadata    ext4  noatime,nosuid,nodev,discard  wait,check
/dev/block/bootdevice/by-name/misc                      /misc        emmc  defaults  defaults
