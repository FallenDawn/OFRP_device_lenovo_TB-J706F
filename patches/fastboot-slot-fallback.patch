From: TB-J706F fastbootd compatibility
Subject: [PATCH] fastbootd: fall back to boot properties when boot control HAL is absent

Some recovery ramdisks do not start android.hardware.boot@1.0::IBootControl.
In that case AOSP fastbootd reports an empty current-slot and slot-count 0,
even when the bootloader has supplied A/B properties.

Keep the boot control HAL as the primary source. When it is unavailable (or
returns an empty suffix), fall back to ro.boot.slot_suffix / ro.boot.slot.
Infer a two-slot layout from ro.build.ab_update or ro.boot.slot_suffix.

This only restores slot identification/count reporting. It does not emulate
IBootControl operations such as marking slots successful/unbootable or setting
the active slot.

Validated against aosp-mirror/platform_system_core android-12.1.0_r27:
  fastboot/device/fastboot_device.cpp
  fastboot/device/variables.cpp

Apply from the Android source root with the companion script:
  bash device/lenovo/pearl_prc_wifi/scripts/apply-fastboot-slot-fallback.sh

diff --git a/fastboot/device/fastboot_device.cpp b/fastboot/device/fastboot_device.cpp
--- a/fastboot/device/fastboot_device.cpp
+++ b/fastboot/device/fastboot_device.cpp
@@ -107,13 +107,24 @@ std::string FastbootDevice::GetCurrentSlot() {
     if (!active_slot_.empty()) {
         return active_slot_;
     }
-    // Non-A/B devices must not have boot control HALs.
-    if (!boot_control_hal_) {
-        return "";
+    if (boot_control_hal_) {
+        std::string suffix;
+        auto cb = [&suffix](hidl_string s) { suffix = s; };
+        boot_control_hal_->getSuffix(boot_control_hal_->getCurrentSlot(), cb);
+        if (!suffix.empty()) {
+            return suffix;
+        }
     }
-    std::string suffix;
-    auto cb = [&suffix](hidl_string s) { suffix = s; };
-    boot_control_hal_->getSuffix(boot_control_hal_->getCurrentSlot(), cb);
+
+    // Recovery may not run a boot control HAL. Fall back to the slot suffix
+    // exported by the bootloader.
+    std::string suffix = android::base::GetProperty("ro.boot.slot_suffix", "");
+    if (suffix.empty()) {
+        suffix = android::base::GetProperty("ro.boot.slot", "");
+    }
+    if (!suffix.empty() && suffix[0] != '_') {
+        suffix.insert(0, "_");
+    }
     return suffix;
 }
 
diff --git a/fastboot/device/variables.cpp b/fastboot/device/variables.cpp
--- a/fastboot/device/variables.cpp
+++ b/fastboot/device/variables.cpp
@@ -186,10 +186,14 @@ bool GetSlotCount(FastbootDevice* device, const std::vector<std::string>& /* ar
                   std::string* message) {
     auto boot_control_hal = device->boot_control_hal();
-    if (!boot_control_hal) {
-        *message = "0";
-    } else {
+    if (boot_control_hal) {
         *message = std::to_string(boot_control_hal->getNumberSlots());
+        return true;
     }
+
+    // No boot control HAL: infer A/B from build/bootloader properties.
+    bool ab = android::base::GetBoolProperty("ro.build.ab_update", false) ||
+              !android::base::GetProperty("ro.boot.slot_suffix", "").empty();
+    *message = ab ? "2" : "0";
     return true;
 }